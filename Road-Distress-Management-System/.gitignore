docker-data/

# Local caches / downloaded binaries (not source) -- e.g. the ffmpeg binary
# transcription_service.py copies in for Whisper, and any local tunnel exe
backend/.cache/
backend/scripts/*.exe


# Archives & media
*.zip
*.mp4

# Model weights -- everything in here is ignored by default (scratch/
# experiment checkpoints, cache files) except the two trained weights the
# pipeline actually loads at runtime (see app/services/ai/model_loader.py),
# which are tracked via Git LFS (see backend/.gitattributes).
backend/models/*
!backend/models/road_best.pth
!backend/models/signage_best.pth

# Runtime-generated output
backend/uploads/
reports/
runs/

# Environment & Python
.env
.venv/
__pycache__/
